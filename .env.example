COMPOSE_PROJECT_NAME=stroski
APP_NAME=Stroski
APP_FULL_BASE_URL=http://localhost:8080
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8080
DB_DIR=./db
STORAGE_DIR=./storage
LOG_DIR=./logs
BACKUP_DIR=./backups
APP_DEFAULT_TIMEZONE=Europe/Ljubljana
APP_DEFAULT_LOCALE=sl_SI
DEBUG=false
SECURITY_SALT=
# Exact peer IPs, comma separated. Never trust arbitrary clients.
TRUSTED_PROXIES=
PHP_MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=25M
